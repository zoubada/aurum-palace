{
  "name": "car-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tools/smoke-test.mjs",
    "data:annecy": "node tools/annecy/0-fetch-osm.mjs && node tools/annecy/1-route.mjs && node tools/annecy/2-fetch-ign.mjs && node tools/annecy/2b-fetch-roofs.mjs && node --max-old-space-size=8192 tools/annecy/3-build.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/proj4": "^2.5.6",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.56.1",
    "proj4": "^2.22.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
